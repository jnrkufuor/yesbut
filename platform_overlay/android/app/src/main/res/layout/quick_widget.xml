<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/w_bg">
    <LinearLayout android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="yes, but" android:textSize="17sp" android:textStyle="bold" android:textColor="#232120"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="*" android:textSize="20sp" android:textStyle="bold" android:textColor="#DF1538"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Check the fine print" android:textSize="11sp" android:textColor="#857E78"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_last" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="#5E5852" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/btn_scan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/w_circle_red">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_w_scan" android:contentDescription="Scan"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Scan" android:textSize="11sp" android:textColor="#232120"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_upload" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/w_circle_blue">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_w_upload" android:contentDescription="Upload"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Upload" android:textSize="11sp" android:textColor="#232120"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_paste" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/w_circle_sun">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_w_paste" android:contentDescription="Paste"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Paste" android:textSize="11sp" android:textColor="#232120"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_link" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/w_circle_ink">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_w_link" android:contentDescription="Link"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Link" android:textSize="11sp" android:textColor="#232120"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
